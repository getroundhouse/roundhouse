<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The app bundle's Info.plist. package.sh fills in both versions and the icon for each build, so they're left out
     here. vpk would write one of its own, but it gives the short version four parts, where macOS expects three, and
     nothing else that macOS reads beyond the basics. -->
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>Roundhouse</string>
	<key>CFBundleExecutable</key>
	<string>roundhouse-desktop</string>
	<key>CFBundleIdentifier</key>
	<string>dev.getroundhouse.desktop</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Roundhouse</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.developer-tools</string>
	<!-- What the binaries are built for: Rust's default for Apple silicon. -->
	<key>LSMinimumSystemVersion</key>
	<string>11.0</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
</dict>
</plist>
