            747f89877799df46 t("The system font, dense but easy to read",SF Pro Text,14,m,align(l),lh(1.6071),ls(-0.1498px)) p(0,12) s(240,hug:45) f[(6c0d0b6e8fd8a398,tok(color.text,#EEE6E1))] $typography.Emphasis "Headline"
            2a943a2b8a670c5e t("Body text is small enough to watch many agents at once and still easy to read, and what's secondary is muted beside it, at the same size or smaller for details.",SF Pro Text,14,r,align(l),lh(1.6071),ls(-0.1498px)) p(256,12) s(fill,hug:45) ext(632,) f[(7c6b3114db4745e7,tok(color.text.muted,#B8B1AC))] $typography.Body "Why"
          ee328d5bb1df83ee r p(0,69) s(fill,1) ext(888,) f[(91223b10a198a061,tok(color.edge,#2D2724))] "Line"
          bc9ba8b8574d1432 al(h,g(16:$spacing.lg),pad(12:$spacing.md,0:$spacing.none,12:$spacing.md,0:$spacing.none)) p(0,70) s(fill,hug:69) ext(888,) f[] "Principle"
            5d10fc313199a9d0 t("Medium stands out, and nothing is bold",SF Pro Text,14,m,align(l),lh(1.6071),ls(-0.1498px)) p(0,12) s(240,hug:45) f[(7e5a581efe9eafbd,tok(color.text,#EEE6E1))] $typography.Emphasis "Headline"
            8935b2b472ef99f7 t("What the app has stand out, such as a card's title, is medium. What someone wrote marks as strong, such as the agent's bold, is semibold, since bold shouts in a dense layout.",SF Pro Text,14,r,align(l),lh(1.6071),ls(-0.1498px)) p(256,12) s(fill,hug:45) ext(632,) f[(498b6446014d24ed,tok(color.text.muted,#B8B1AC))] $typography.Body "Why"
          ceea4deee7454b87 r p(0,139) s(fill,1) ext(888,) f[(4e565e114b09a506,tok(color.edge,#2D2724))] "Line"
          f497c9f07312583b al(h,g(16:$spacing.lg),pad(12:$spacing.md,0:$spacing.none,12:$spacing.md,0:$spacing.none)) p(0,140) s(fill,hug:46.5) ext(888,) f[] "Principle"
            20e65e8d7c8ee9ce t("Letters as the font draws them",SF Pro Text,14,m,align(l),lh(1.6071),ls(-0.1498px)) p(0,12) s(240,hug:22.5) f[(22e907c70cd6eebe,tok(color.text,#EEE6E1))] $typography.Emphasis "Headline"
            837ac2a42e47c425 t("macOS's thickening is off, so a weight looks the same in every colour.",SF Pro Text,14,r,align(l),lh(1.6071),ls(-0.1498px)) p(256,12) s(fill,hug:22.5) ext(632,) f[(ebd8bbd31a464d05,tok(color.text.muted,#B8B1AC))] $typography.Body "Why"
          c08cbe1b5c3ea17e r p(0,186.5) s(fill,1) ext(888,) f[(e1776202b0bc094b,tok(color.edge,#2D2724))] "Line"
          a5525fcc68f2f94d al(h,g(16:$spacing.lg),pad(12:$spacing.md,0:$spacing.none,12:$spacing.md,0:$spacing.none)) p(0,187.5) s(fill,hug:91.5) ext(888,) f[] "Principle"
            a0a0e6d6d79b5dda t("A name changes only for what needs you",SF Pro Text,14,m,align(l),lh(1.6071),ls(-0.1498px)) p(0,12) s(240,hug:45) f[(f9fbeed76c86d9aa,tok(color.text,#EEE6E1))] $typography.Emphasis "Headline"
            e58e84a57fa9b15f t("In a list of one kind of thing, such as the workspaces, a name's colour and weight change only for what needs you, since names are read side by side and any change reads as news. What's chosen shows in its background.",SF Pro Text,14,r,align(l),lh(1.6071),ls(-0.1498px)) p(256,12) s(fill,hug:67.5) ext(632,) f[(82d6b4799a5fae61,tok(color.text.muted,#B8B1AC))] $typography.Body "Why"
          32fef8ac6c024da8 r p(0,279) s(fill,1) ext(888,) f[(42ff15ef4b5207b0,tok(color.edge,#2D2724))] "Line"
          92c5ae480de18be6 al(h,g(16:$spacing.lg),pad(12:$spacing.md,0:$spacing.none,12:$spacing.md,0:$spacing.none)) p(0,280) s(fill,hug:69) ext(888,) f[] "Principle"
            265d1b6bbdcd8361 t("Each kind has a name for what it is for",SF Pro Text,14,m,align(l),lh(1.6071),ls(-0.1498px)) p(0,12) s(240,hug:45) f[(227afc2331320f0d,tok(color.text,#EEE6E1))] $typography.Emphasis "Headline"
            51707e385daf05ac t("So a size means the same wherever it is set, and two kinds that are the same size today, such as details and code, can change apart.",SF Pro Text,14,r,align(l),lh(1.6071),ls(-0.1498px)) p(256,12) s(fill,hug:45) ext(632,) f[(7d603cc261f8b5c6,tok(color.text.muted,#B8B1AC))] $typography.Body "Why"
          df8e01bf43e9516d r p(0,349) s(fill,1) ext(888,) f[(867e621ab2bfb13b,tok(color.edge,#2D2724))] "Line"
          f3cc21b2de2ba931 al(h,g(16:$spacing.lg),pad(12:$spacing.md,0:$spacing.none,12:$spacing.md,0:$spacing.none)) p(0,350) s(fill,hug:69) ext(888,) f[] "Principle"
            d15483267f6dba53 t("One baseline along a line",SF Pro Text,14,m,align(l),lh(1.6071),ls(-0.1498px)) p(0,12) s(240,hug:22.5) f[(2a98cd4a6b082485,tok(color.text,#EEE6E1))] $typography.Emphasis "Headline"
            3b7d04d36f90ed46 t("Text in different sizes or fonts along one line sits on one baseline, as a sentence's words do. An icon, and text on a shape such as a button, stays centred.",SF Pro Text,14,r,align(l),lh(1.6071),ls(-0.1498px)) p(256,12) s(fill,hug:45) ext(632,) f[(1ed36452e6c21761,tok(color.text.muted,#B8B1AC))] $typography.Body "Why"
