            6e8836577169d134 t("Where something went",SF Pro Text,14,m,align(l),lh(1.6071),ls(-0.1498px)) p(0,12) s(240,hug:22.5) f[(6d3614bb3f669ee2,tok(color.text,#EEE6E1))] $typography.Emphasis "Headline"
            24bc6626a6e3535a t("A panel slides out past its edge, a row slides to its new place and a scroll passes the rows, so it's plain where each went. What comes and goes in place fades.",SF Pro Text,14,r,align(l),lh(1.6071),ls(-0.1498px)) p(256,12) s(fill,hug:45) ext(632,) f[(9bebedd1419e3644,tok(color.text.muted,#B8B1AC))] $typography.Body "Why"
