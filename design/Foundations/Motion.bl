          433626f31ff88206 al(h,g(16:$spacing.lg),pad(12:$spacing.md,0:$spacing.none,12:$spacing.md,0:$spacing.none)) p(0,70) s(fill,hug:69) ext(888,) f[] "Principle"
            1ff3ddfe5207cc5a t("Never waited for",SF Pro Text,14,m,align(l),lh(1.6071),ls(-0.1498px)) p(0,12) s(240,hug:22.5) f[(49ade3f9f221f368,tok(color.text,#EEE6E1))] $typography.Emphasis "Headline"
            cdafe8d7383f930f t("A fifth of a second for a panel, a row or a fade, and three tenths for a scroll, which goes further. What opens from something takes less, since it's opened many times a day.",SF Pro Text,14,r,align(l),lh(1.6071),ls(-0.1498px)) p(256,12) s(fill,hug:45) ext(632,) f[(cb9412b368cd1040,tok(color.text.muted,#B8B1AC))] $typography.Body "Why"
          ea3de248fb88bc05 r p(0,139) s(fill,1) ext(888,) f[(25b7a5c5ee35fd5d,tok(color.edge,#2D2724))] "Line"
