            274f8193bf9706c9 t("Reduce Motion is kept",SF Pro Text,14,m,align(l),lh(1.6071),ls(-0.1498px)) p(0,12) s(240,hug:22.5) f[(0786ee1d9dc04722,tok(color.text,#EEE6E1))] $typography.Emphasis "Headline"
            d5c72f8e92b5f527 t("What moves is where it's going at once, and the mark, the ring and the robot hold still.",SF Pro Text,14,r,align(l),lh(1.6071),ls(-0.1498px)) p(256,12) s(fill,hug:22.5) ext(632,) f[(e9e512758f585111,tok(color.text.muted,#B8B1AC))] $typography.Body "Why"
