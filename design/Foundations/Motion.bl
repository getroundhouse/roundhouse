            90607774453ca455 t("Work moves while it goes on",SF Pro Text,14,m,align(l),lh(1.6071),ls(-0.1498px)) p(0,12) s(240,hug:22.5) f[(1bb2f263ef3096c3,tok(color.text,#EEE6E1))] $typography.Emphasis "Headline"
