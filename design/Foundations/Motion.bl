            624889c53ade8fa5 t("A list scrolling on under a drag goes by the pointer rather than by a time, faster the further past its edge the pointer is, from 240 to 4,800 points a second, so Reduce Motion leaves it be.",SF Pro Text,14,r,align(l),lh(1.6071),ls(-0.1498px)) p(0,26.5) s(fill,hug:45) ext(888,) f[(60298feab8650b62,tok(color.text.muted,#B8B1AC))] $typography.Body "Purpose"
