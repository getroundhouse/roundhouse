            c759c508861e4013 t("Slowing as it arrives",SF Pro Text,14,m,align(l),lh(1.6071),ls(-0.1498px)) p(0,12) s(240,hug:22.5) f[(ad3580adb71edbea,tok(color.text,#EEE6E1))] $typography.Emphasis "Headline"
            b785b697aae0819b t("On one curve, so its start reads as an answer and its end as settling.",SF Pro Text,14,r,align(l),lh(1.6071),ls(-0.1498px)) p(256,12) s(fill,hug:22.5) ext(632,) f[(c01874d160edd0ff,tok(color.text.muted,#B8B1AC))] $typography.Body "Why"
