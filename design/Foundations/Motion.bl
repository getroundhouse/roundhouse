            1ff3ddfe5207cc5a t("Never waited for",SF Pro Text,14,m,align(l),lh(1.6071),ls(-0.1498px)) p(0,12) s(240,hug:22.5) f[(49ade3f9f221f368,tok(color.text,#EEE6E1))] $typography.Emphasis "Headline"
            cdafe8d7383f930f t("A fifth of a second for a panel, a row or a fade, and three tenths for a scroll, which goes further.",SF Pro Text,14,r,align(l),lh(1.6071),ls(-0.1498px)) p(256,12) s(fill,hug:22.5) ext(632,) f[(cb9412b368cd1040,tok(color.text.muted,#B8B1AC))] $typography.Body "Why"
