          d9a4c8ee2d00b1f8 al(h,g(16:$spacing.lg),pad(12:$spacing.md,0:$spacing.none,12:$spacing.md,0:$spacing.none)) p(0,187.5) s(fill,hug:69) ext(888,) f[] "Principle"
            8c5dcd7218f957a5 t("From where it is",SF Pro Text,14,m,align(l),lh(1.6071),ls(-0.1498px)) p(0,12) s(240,hug:22.5) f[(9b276d9ef5bc7722,tok(color.text,#EEE6E1))] $typography.Emphasis "Headline"
            5a51b22309e841f7 t("One turned back partway doesn't jump, and at rest it asks for no frames, so an idle window draws nothing.",SF Pro Text,14,r,align(l),lh(1.6071),ls(-0.1498px)) p(256,12) s(fill,hug:45) ext(632,) f[(fbb297f10dbb70cc,tok(color.text.muted,#B8B1AC))] $typography.Body "Why"
