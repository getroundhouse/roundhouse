            90607774453ca455 t("Work moves while it goes on",SF Pro Text,14,m,align(l),lh(1.6071),ls(-0.1498px)) p(0,12) s(240,hug:22.5) f[(1bb2f263ef3096c3,tok(color.text,#EEE6E1))] $typography.Emphasis "Headline"
            c9151b2e641f2b58 t("The mark's light, a task's ring and a subagent's robot, each at its own pace.",SF Pro Text,14,r,align(l),lh(1.6071),ls(-0.1498px)) p(256,12) s(fill,hug:22.5) ext(632,) f[(592e6e71a15cebf6,tok(color.text.muted,#B8B1AC))] $typography.Body "Why"
