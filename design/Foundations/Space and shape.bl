          c6d2935703c8bcec t("Set by the text, as its lines are: paragraphs 0.75 of a rem apart, and a list's items a quarter of their text, so a reply keeps its places against its text, as the kit's own spacing does on a handheld.",SF Pro Text,14,r,align(l),lh(1.6071),ls(-0.1498px)) p(0,49) s(fill,hug:112.5) ext(288,) f[(4f7360338b496fc0,tok(color.text,#EEE6E1))] $typography.Body "Choice"
