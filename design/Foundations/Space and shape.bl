          978244408874bf65 al(h,g(16:$spacing.lg),pad(12:$spacing.md,0:$spacing.none,12:$spacing.md,0:$spacing.none)) p(0,70) s(fill,hug:69) ext(888,) f[] "Principle"
            960b70993c8ec69c t("Six steps of space",SF Pro Text,14,m,align(l),lh(1.6071),ls(-0.1498px)) p(0,12) s(240,hug:22.5) f[(4d57fb6377e8ec80,tok(color.text,#EEE6E1))] $typography.Emphasis "Headline"
            759cc586bd1177aa t("Every gap, padding and margin is one of six steps on a 4px grid, taken by its name, so the next space is a choice among six.",SF Pro Text,14,r,align(l),lh(1.6071),ls(-0.1498px)) p(256,12) s(fill,hug:45) ext(632,) f[(9b2f5507952e95b0,tok(color.text.muted,#B8B1AC))] $typography.Body "Why"
          4f599dc40fe3939a r p(0,139) s(fill,1) ext(888,) f[(7e2ec3cae5a60578,tok(color.edge,#2D2724))] "Line"
          e0ef3fe09160c992 al(h,g(16:$spacing.lg),pad(12:$spacing.md,0:$spacing.none,12:$spacing.md,0:$spacing.none)) p(0,140) s(fill,hug:69) ext(888,) f[] "Principle"
            b3e2cf033053722a t("A length for something else isn't a space",SF Pro Text,14,m,align(l),lh(1.6071),ls(-0.1498px)) p(0,12) s(240,hug:45) f[(60a3238d1bf6bffe,tok(color.text,#EEE6E1))] $typography.Emphasis "Headline"
            cea6e9b2a3da7059 t("One that lines a thing up, keeps clear of what the app doesn't lay out, or belongs to a drawing is set by what it's for, rather than by a step.",SF Pro Text,14,r,align(l),lh(1.6071),ls(-0.1498px)) p(256,12) s(fill,hug:45) ext(632,) f[(f085e3a1971081dc,tok(color.text.muted,#B8B1AC))] $typography.Body "Why"
          483bd099424e7539 r p(0,209) s(fill,1) ext(888,) f[(1e8cb884c5428897,tok(color.edge,#2D2724))] "Line"
          b3c09819a0cac2f8 al(h,g(16:$spacing.lg),pad(12:$spacing.md,0:$spacing.none,12:$spacing.md,0:$spacing.none)) p(0,210) s(fill,hug:69) ext(888,) f[] "Principle"
            2e7e20f62e0cc1f2 t("A corner for what it's on",SF Pro Text,14,m,align(l),lh(1.6071),ls(-0.1498px)) p(0,12) s(240,hug:22.5) f[(00973ddad5594987,tok(color.text,#EEE6E1))] $typography.Emphasis "Headline"
            4b482c4aaa2b550c t("Controls have a control's corners and cards a card's, so a row to choose inside a card has a corner that sits inside the card's.",SF Pro Text,14,r,align(l),lh(1.6071),ls(-0.1498px)) p(256,12) s(fill,hug:45) ext(632,) f[(283a127e2133f87f,tok(color.text.muted,#B8B1AC))] $typography.Body "Why"
          c8092c90b36d5aa3 r p(0,279) s(fill,1) ext(888,) f[(83da109f7a70944d,tok(color.edge,#2D2724))] "Line"
          f5b79f47fb4c6344 al(h,g(16:$spacing.lg),pad(12:$spacing.md,0:$spacing.none,12:$spacing.md,0:$spacing.none)) p(0,280) s(fill,hug:69) ext(888,) f[] "Principle"
            1aa5e9148d2f66c7 t("A size for where it sits",SF Pro Text,14,m,align(l),lh(1.6071),ls(-0.1498px)) p(0,12) s(240,hug:22.5) f[(5c8f08b86de07b86,tok(color.text,#EEE6E1))] $typography.Emphasis "Headline"
            a69da9107d7356e1 t("Controls, bars, rows and icons each come in a few sizes for the kind of place they are in, so the same kind of place looks the same wherever it is.",SF Pro Text,14,r,align(l),lh(1.6071),ls(-0.1498px)) p(256,12) s(fill,hug:45) ext(632,) f[(d54d752302bf0e67,tok(color.text.muted,#B8B1AC))] $typography.Body "Why"
          6ff378ffd243e199 r p(0,349) s(fill,1) ext(888,) f[(72c27af50c0229ff,tok(color.edge,#2D2724))] "Line"
          291857d0dc0e20da al(h,g(16:$spacing.lg),pad(12:$spacing.md,0:$spacing.none,12:$spacing.md,0:$spacing.none)) p(0,350) s(fill,hug:91.5) ext(888,) f[] "Principle"
            28a98b33b3214ad3 t("Larger to touch",SF Pro Text,14,m,align(l),lh(1.6071),ls(-0.1498px)) p(0,12) s(240,hug:22.5) f[(0580612c911b0fe1,tok(color.text,#EEE6E1))] $typography.Emphasis "Headline"
            1e0f32b4ce1b7c2d t("On a handheld, controls, bars, rows and icons are larger, to be touched. Spaces and corners stay as they are, in pixels, whatever size text is set at, but for the room the text sets, such as between a reply's paragraphs, which grows with it, as the kit's own spacing does.",SF Pro Text,14,r,align(l),lh(1.6071),ls(-0.1498px)) p(256,12) s(fill,hug:67.5) ext(632,) f[(e441fab954926633,tok(color.text.muted,#B8B1AC))] $typography.Body "Why"
