        69e6db8686154a5c r p(0,0) s(fill,1) ext(888,) f[(70c18a14fbe12eac,tok(color.edge,#2D2724))] "Rule"
        c9ee98550f3c8497 al(v,g(4:$spacing.xs)) p(0,13) s(fill,hug:97.5) ext(888,) f[] "Head"
          017bbd0bfe468e30 t("How they are made",SF Pro Text,16,m,align(l),lh(1.625),ls(-0.3104px)) p(0,0) s(fill,hug:26) ext(888,) f[(305bba3e6efc76e5,tok(color.text,#EEE6E1))] $typography.Heading "Heading"
          6f6a7355b31a6239 t("Each is a token named as look names it: the steps of its Space, its Corner, ControlSize, BarSize, RowSize and IconSize, and the widths of its lines. One that's larger on a handheld has a value for each reach. The design system has the same names, and a test holds its values to the app's.",SF Pro Text,14,r,align(l),lh(1.6071),ls(-0.1498px)) p(0,30) s(fill,hug:67.5) ext(888,) f[(96218169d74c49e1,tok(color.text.muted,#B8B1AC))] $typography.Body "Purpose"
        803ddcc2d36b1572 al(v,g(8:$spacing.sm)) p(0,122.5) s(fill,hug:71.5) ext(888,) f[] "Steps, and lengths that are not"
