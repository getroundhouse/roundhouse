            1be0e52d1ef7dcfb t("A stroke takes no room here",SF Pro Text,14,m,align(l),lh(1.6071),ls(-0.1498px)) p(0,0) s(fill,hug:22.5) ext(888,) f[(3d5b46ec71d0d20d,tok(color.text,#EEE6E1))] $typography.Emphasis "Heading"
            8bb04ca57c2e2909 t("In the app, an edge takes a pixel inside a part, and in Brilliant a stroke takes none, so what has an edge is inset a pixel more: its step of space and the edge's pixel, as EdgedXSmall to EdgedLarge are, and a chip's own as ChipStart and ChipEnd are.",SF Pro Text,14,r,align(l),lh(1.6071),ls(-0.1498px)) p(0,26.5) s(fill,hug:45) ext(888,) f[(8ebdc165aad91f8e,tok(color.text.muted,#B8B1AC))] $typography.Body "Purpose"
