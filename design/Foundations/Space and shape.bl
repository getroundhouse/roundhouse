            a43986aa43cab817 t("Steps, and lengths that are not",SF Pro Text,14,m,align(l),lh(1.6071),ls(-0.1498px)) p(0,0) s(fill,hug:22.5) ext(888,) f[(72576719da18e9d7,tok(color.text,#EEE6E1))] $typography.Emphasis "Heading"
            54052f326681767f t("Space is six steps of a 4px grid, named XSmall to XXLarge, and written xs to 2xl here. A length set for something else, such as a chip's inside, is a token of its own, named for what it's for.",SF Pro Text,14,r,align(l),lh(1.6071),ls(-0.1498px)) p(0,26.5) s(fill,hug:45) ext(888,) f[(790ccd5e2c980e8d,tok(color.text.muted,#B8B1AC))] $typography.Body "Purpose"
