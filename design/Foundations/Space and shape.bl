          5b2c42745412ee19 t("40px, so it holds a small button with room above and below it, as at a desk. A banner, the one thing sized from it there, was already as tall.",SF Pro Text,14,r,align(l),lh(1.6071),ls(-0.1498px)) p(0,26.5) s(fill,hug:90) ext(288,) f[(fc621ef5dfb3fac3,tok(color.text,#EEE6E1))] $typography.Body "Choice"
