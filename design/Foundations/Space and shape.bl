            52749f0700ed9633 t("What belongs together is closer",SF Pro Text,14,m,align(l),lh(1.6071),ls(-0.1498px)) p(0,12) s(240,hug:22.5) f[(5b8c66e896dc2a87,tok(color.text,#EEE6E1))] $typography.Emphasis "Headline"
            8c393ed505acb939 t("A project's row and its workspaces are closer to each other than to the next project, so the room between things says how they go together.",SF Pro Text,14,r,align(l),lh(1.6071),ls(-0.1498px)) p(256,12) s(fill,hug:45) ext(632,) f[(4157db466613d482,tok(color.text.muted,#B8B1AC))] $typography.Body "Why"
