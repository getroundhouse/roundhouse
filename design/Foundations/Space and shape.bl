  cf77adb35cf22175 t("S2 · A mark beside text on a handheld",SF Pro Display,24,m,align(l),lh(1.625),ls(0.324px)) p(24,24) s(hug:397.45,hug:39) f[(e30a1571ad5d4d72,tok(color.text,#EEE6E1))] $typography.PageTitle "Question"
  4b9a00a5f60ef859 t("A large icon is to be as big as a mark beside text, so a call's icon and the working line's mark take one place, and the words after them line up. At a desk both are 16px. On a handheld a large icon is 22px and the mark stays 16, so a call's icon is set in the mark's 16px place, and runs 6px into the room before its words. Each picture is the iPhone's gallery, drawn with the option.",SF Pro Text,14,r,align(l),lh(1.6071),ls(-0.1498px)) p(24,87) s(720,hug:90) f[(ef77d7c82074539c,tok(color.text.muted,#B8B1AC))] $typography.Body "Between"
