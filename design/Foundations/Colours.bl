            e2a21266c0ff8517 t("use std::fmt;\n// Says which one it is.\nfn label(id: u32) -> &str {\n    let name = \"aspen\";\n    if id > 0 { return name; }\n    \"\"\n}",Menlo,12,r,align(l),lh(1.4167:$font.lineHeight.CodeChat),ls(0px)) p(12,12) s(fill,hug:119.01) ext(386,) f[(5a264e16f31f54ac,#DCDCDC)] $typography.Code "Code"
              spans[(0,3,#C586C0),(14,38,#608B4E),(39,41,#569CD6),(42,47,#DCDCAA),(48,50,#9CDCFE),(52,55,#569CD6),(60,61,#C586C0),(61,64,#569CD6),(71,74,#569CD6),(82,89,#D69D85),(95,97,#C586C0),(103,104,#B5CEA8),(107,113,#C586C0),(126,128,#D69D85)]
          159be71927d3f8c7 t("Nothing changes. No role names these, so the design draws code with bare colours that no test holds to the app's, and plain code stays a cool grey, #dcdcdc, beside the warm text around it.",SF Pro Text,12,r,align(l),lh(auto,1.17),ls(0px)) p(12,193.51) s(fill,hug:42) ext(410,) f[(d74f52fcff3968fe,tok(color.text.muted,#B8B1AC))] $typography.Detail "Cost"
