          c84588e73796ff63 t("Every strength drawn today gets a name for what it's for, such as Wash and LineOnAWash, at its value, so nothing moves on screen. needs_you is shown at each: 8, 9 and 10 can't be told apart, nor can 11, 12 and 14, and the next strength is added where it's first needed.",SF Pro Text,12,r,align(l),lh(auto,1.17),ls(0px)) p(12,134.5) s(fill,hug:84) ext(261.33,) f[(da3d7ad8e5d78ae8,tok(color.text.muted,#B8B1AC))] $typography.Detail "Cost"
        cd25f9a64a913a11 al(v,g(8:$spacing.sm),pad(12:$spacing.md)) p(594.67,0) s(fill,hug:161) ext(285.33,) f[(077941e1f02c298c,tok(color.surface.pane,#140F0C))] st[(068cacfc645f7bb2,tok(color.edge,#2D2724),w(1:$stroke.width.Edge),pos(i))] rd(6:$radius.Control) "C · Only what's drawn"
          e7703a1e8329a472 t("C · A token for each colour drawn at a strength",SF Pro Text,14,m,align(l),lh(1.6071),ls(-0.1498px)) p(12,12) s(fill,hug:45) ext(261.33,) f[(5d0b6f46e119d052,tok(color.text,#EEE6E1))] $typography.Emphasis "Label"
          974573afb837cb12 t("As the plan card's needs_you_wash is: the design adds a colour at a strength when a canvas first draws it. Nothing moves on screen, and nothing holds the app's strengths to a set, so the design and the app can each choose one the other lacks.",SF Pro Text,12,r,align(l),lh(auto,1.17),ls(0px)) p(12,65) s(fill,hug:84) ext(261.33,) f[(db15bc44bbc54979,tok(color.text.muted,#B8B1AC))] $typography.Detail "Cost"
      c86d879de1a27819 t("Decided: A, by the owner on 2026-11-26 in chat, as recommended. It does for tints what the six steps did for spacing: a short set chosen once, so the next tint is a choice among seven rather than a new number, and nothing moves enough to see.",SF Pro Text,14,r,align(l),lh(1.6071),ls(-0.1498px)) p(16,518) s(fill,hug:45) ext(880,) f[(49797ae79fcbd66c,tok(color.text,#EEE6E1))] $typography.Body "Recommended"
