      d0451e77acd46c68 t("Next",SF Pro Text,16,m,align(l),lh(auto,1.19),ls(-0.3104px)) p(16,16) s(hug:34.58,hug:19) f[(9b8bb4ea567eb0e6,tok(color.text,#EEE6E1))] $typography.Heading "Heading"
      67c7c9c464c4a32a t("C4 · Do row_hover and menu_hover take names for what they draw? Nothing on screen is row_hover, since only the kit's diff reads it. menu_hover is the kit's accent, behind inline code, and the proposal outline's rows draw with it too. The kit's own parts also draw with accent, such as the menu a text field shows under touch, and whether the app reaches them wasn't traced.",SF Pro Text,14,r,align(l),lh(1.6071),ls(-0.1498px)) p(16,43) s(fill,hug:67.5) ext(880,) f[(2214c4944c8b7f26,tok(color.text.muted,#B8B1AC))] $typography.Body "C4"
      9a092752a976a8cf t("C5 · Do roles that share a colour mean different things? needs_you, warning and modified are one amber; stopped, error and removed one red; done and added one green; and inset, row_hover and button, edge and raised_hover, control_edge and raised_pressed, and line_hover and on_main are each one grey.",SF Pro Text,14,r,align(l),lh(1.6071),ls(-0.1498px)) p(16,118.5) s(fill,hug:67.5) ext(880,) f[(c63fe73d5f58e808,tok(color.text.muted,#B8B1AC))] $typography.Body "C5"
      331fe663a04749f7 t("C6 · How readable must text be? Faint is at Lc 30 on the pane, the least for any text, in about 95 places, among them meta and line numbers. Words in a colour aren't held to muted's 60: on the pane the app's red reads at 46, copper at 48, merged's purple at 41 and closed at 32, and on a code block nine of Dark+'s 20 colours read under 60, a keyword at 47.",SF Pro Text,14,r,align(l),lh(1.6071),ls(-0.1498px)) p(16,194) s(fill,hug:67.5) ext(880,) f[(b8eb66e7c679cd78,tok(color.text.muted,#B8B1AC))] $typography.Body "C6"
      0618f16764c60e1a t("C7 · What shows a press under touch? No colour under the pointer has a use there, and the press the spec puts in its place names no colour.",SF Pro Text,14,r,align(l),lh(1.6071),ls(-0.1498px)) p(16,269.5) s(fill,hug:45) ext(880,) f[(4c547c3715273de1,tok(color.text.muted,#B8B1AC))] $typography.Body "C7"
      84c60791f4c80218 t("C8 · Are the main action's three colours and the brand's tints made, as the greys and text are, or picked? main, main_hover, main_pressed, current, link and link_hover are each a value of its own.",SF Pro Text,14,r,align(l),lh(1.6071),ls(-0.1498px)) p(16,322.5) s(fill,hug:45) ext(880,) f[(36595491e282c944,tok(color.text.muted,#B8B1AC))] $typography.Body "C8"
  a23a9a21d8409027 al(v,g(16:$spacing.lg)) p(24,519.5) s(fill,hug:1599.51) ext(912,) f[] "Decided"
