          a2db8ccbf399344d t("How a role is made",SF Pro Text,16,m,align(l),lh(1.625),ls(-0.3104px)) p(0,0) s(fill,hug:26) ext(888,) f[(cba2d472ce1f339c,tok(color.text,#EEE6E1))] $typography.Heading "Heading"
          24db1ec14b8b1e28 t("Each role is made one of five ways, as look's Colors makes it, so tuning the palette is changing one number. The design system has the same names, and a test holds its values to the app's.",SF Pro Text,14,r,align(l),lh(1.6071),ls(-0.1498px)) p(0,30) s(fill,hug:45) ext(888,) f[(e42a22f6fd4adcf6,tok(color.text.muted,#B8B1AC))] $typography.Body "Purpose"
