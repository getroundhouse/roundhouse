      39e2aa981b928944 t("C1 · How strong is a colour drawn over another?",SF Pro Text,16,m,align(l),lh(auto,1.19),ls(-0.3104px)) p(16,16) s(hug:353.31,hug:19) f[(386b2a70065e5294,tok(color.text,#EEE6E1))] $typography.Heading "Question"
      1f8004358abd5de7 t("Between a scale of named strengths, a name for each strength as it's drawn today, and strengths left where they're drawn.",SF Pro Text,14,r,align(l),lh(1.6071),ls(-0.1498px)) p(16,47) s(fill,hug:22.5) ext(880,) f[(c56fe04f3645d503,tok(color.text.muted,#B8B1AC))] $typography.Body "Between"
      4bed5bc683e9de5c t("look draws a colour over another at about twenty strengths, from 6% to 75%, each chosen where it's drawn: a card's wash is needs_you at 9%, a diff's line added at 12%, a selection brand at 30%. Brilliant can draw a role at a strength that's a token of its own, needs_you at a strength named Wash, with the same pixels as a colour of its own, so the design needs a token for each strength, not one for each colour at each strength.",SF Pro Text,14,r,align(l),lh(1.6071),ls(-0.1498px)) p(16,81.5) s(fill,hug:90) ext(880,) f[(1e6249a30d012af5,tok(color.text,#EEE6E1))] $typography.Body "Context"
