          a33118a2296eacae t("color.PR.open names the app's green, as added and done do, so there's one green, and the bar's words read at Lc 58. Merged, closed, a draft and the queue keep GitHub's colours, so an open pull request is the one state that looks less like GitHub's.",SF Pro Text,12,r,align(l),lh(auto,1.17),ls(0px)) p(12,150.5) s(fill,hug:56) ext(410,) f[(7cd12694fc1e0023,tok(color.text.muted,#B8B1AC))] $typography.Detail "Cost"
      f4d693ffee9b71bc t("Decided: B, by the owner on 2026-11-26 in chat, as recommended. One green then means one thing on screen, and the bar's words read more easily, at 58 rather than 50.",SF Pro Text,14,r,align(l),lh(1.6071),ls(-0.1498px)) p(16,369) s(fill,hug:45) ext(880,) f[(4d2d45980a8e55db,tok(color.text,#EEE6E1))] $typography.Body "Recommended"
