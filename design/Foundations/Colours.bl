            47200a93d328d03d t("use std::fmt;\n// Says which one it is.\nfn label(id: u32) -> &str {\n    let name = \"aspen\";\n    if id > 0 { return name; }\n    \"\"\n}",Menlo,12,r,align(l),lh(1.4167:$font.lineHeight.CodeChat),ls(0px)) p(12,12) s(fill,hug:119.01) ext(386,) f[(93365ae9055d7a3d,tok(color.text,#EEE6E1))] $typography.Code "Code"
              spans[(0,3,#C586C0),(14,38,#608B4E),(39,41,#569CD6),(42,47,#DCDCAA),(48,50,#9CDCFE),(52,55,#569CD6),(60,61,#C586C0),(61,64,#569CD6),(71,74,#569CD6),(82,89,#D69D85),(95,97,#C586C0),(103,104,#B5CEA8),(107,113,#C586C0),(126,128,#D69D85)]
          389302a9037e1cf1 t("A role for each of the 19 colours Dark+ draws besides plain code, such as color.code.keyword, string and comment, at Dark+'s values, and look::highlight maps Dark+'s scopes to them. Plain code takes text, so it's as warm as the words around it. That's the one change on screen, and it redraws every gallery picture with code in it, as #2811 did. The design draws code with roles, and a test holds them to the app's.",SF Pro Text,12,r,align(l),lh(auto,1.17),ls(0px)) p(12,193.51) s(fill,hug:84) ext(410,) f[(5b23115e0f74aab3,tok(color.text.muted,#B8B1AC))] $typography.Detail "Cost"
      dbd18cdd0d55a655 t("Decided: B, by the owner on 2026-11-26 in chat, as recommended. Code is drawn on many screens, so their canvases need roles to draw it with, and a test to hold them to the app's. How readable code's colours must be is C6's.",SF Pro Text,14,r,align(l),lh(1.6071),ls(-0.1498px)) p(16,462.51) s(fill,hug:45) ext(880,) f[(25c877276ff33927,tok(color.text,#EEE6E1))] $typography.Body "Recommended"
