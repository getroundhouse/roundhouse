      c3b94e00ac7f6f3f t("Between GitHub's own green, #3fb950, and the green the app draws what's added and what's done in, #6cc488.",SF Pro Text,14,r,align(l),lh(1.6071),ls(-0.1498px)) p(16,47) s(fill,hug:22.5) ext(880,) f[(23f5931651b845e5,tok(color.text.muted,#B8B1AC))] $typography.Body "Between"
      3ebfeaa2cba55c4a t("A pull request's state is in GitHub's colours, which the people Roundhouse is for already know. Its bar is washed in that colour at 12%, with an edge at 35%, and sits above the changes, whose counts are the app's green and red.",SF Pro Text,14,r,align(l),lh(1.6071),ls(-0.1498px)) p(16,81.5) s(fill,hug:45) ext(880,) f[(ea92912669e5cbc8,tok(color.text,#EEE6E1))] $typography.Body "Context"
