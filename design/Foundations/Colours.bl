            166d0c08622aac2b t("Each colour means one thing",SF Pro Text,14,m,align(l),lh(1.6071),ls(-0.1498px)) p(0,12) s(240,hug:22.5) f[(57fae5cbf4150e7c,tok(color.text,#EEE6E1))] $typography.Emphasis "Headline"
            e5d42ca0eb8e7a4d t("It's drawn by a name for what it's for, so it means the same wherever it's drawn, and two that look alike, such as an approval's amber and a warning's, can change apart.",SF Pro Text,14,r,align(l),lh(1.6071),ls(-0.1498px)) p(256,12) s(fill,hug:45) ext(632,) f[(2d70a5f6892e8cff,tok(color.text.muted,#B8B1AC))] $typography.Body "Why"
          8f0b6badf67e1ccb r p(0,69) s(fill,1) ext(888,) f[(9be3ca061cd2a345,tok(color.edge,#2D2724))] "Line"
          5a736b69571953d7 al(h,g(16:$spacing.lg),pad(12:$spacing.md,0:$spacing.none,12:$spacing.md,0:$spacing.none)) p(0,70) s(fill,hug:91.5) ext(888,) f[] "Principle"
            400e87f9acc3eb9d t("A calm, warm, dark field",SF Pro Text,14,m,align(l),lh(1.6071),ls(-0.1498px)) p(0,12) s(240,hug:22.5) f[(1fb4189739881968,tok(color.text,#EEE6E1))] $typography.Emphasis "Headline"
            695c7bf2b68eda61 t("The greys are near-blacks on the brand's hue, so the app reads as one calm field with a few raised things on it. It's dark only, and a light theme would be a second set of values for the same names.",SF Pro Text,14,r,align(l),lh(1.6071),ls(-0.1498px)) p(256,12) s(fill,hug:67.5) ext(632,) f[(d58e058f61e2b615,tok(color.text.muted,#B8B1AC))] $typography.Body "Why"
          e6825c22b7ba580e r p(0,161.5) s(fill,1) ext(888,) f[(2faf14588014e9f2,tok(color.edge,#2D2724))] "Line"
          719464b6d11d596a al(h,g(16:$spacing.lg),pad(12:$spacing.md,0:$spacing.none,12:$spacing.md,0:$spacing.none)) p(0,162.5) s(fill,hug:69) ext(888,) f[] "Principle"
            cf6c3a7a7652e62e t("Status colours only say status",SF Pro Text,14,m,align(l),lh(1.6071),ls(-0.1498px)) p(0,12) s(240,hug:22.5) f[(9ff86c47b6e37461,tok(color.text,#EEE6E1))] $typography.Emphasis "Headline"
            02bc02320b9ded20 t("Copper is the brand and never a status, and a file's icon sits where no status would, so a colour that says how something stands is never taken for anything else.",SF Pro Text,14,r,align(l),lh(1.6071),ls(-0.1498px)) p(256,12) s(fill,hug:45) ext(632,) f[(e33f55ace9b62b40,tok(color.text.muted,#B8B1AC))] $typography.Body "Why"
          d038aa9981841453 r p(0,231.5) s(fill,1) ext(888,) f[(92db1c0b4a41c82d,tok(color.edge,#2D2724))] "Line"
          013bd3106c97d3b7 al(h,g(16:$spacing.lg),pad(12:$spacing.md,0:$spacing.none,12:$spacing.md,0:$spacing.none)) p(0,232.5) s(fill,hug:69) ext(888,) f[] "Principle"
            d8f5e2b0de79dcc8 t("Familiar where people know it",SF Pro Text,14,m,align(l),lh(1.6071),ls(-0.1498px)) p(0,12) s(240,hug:22.5) f[(91be6249f126c9bb,tok(color.text,#EEE6E1))] $typography.Emphasis "Headline"
            c81d30a4128bed51 t("A diff, code and a pull request are in the colours people's tools draw them in: review tools', Dark+ and GitHub's, but for the app's own green.",SF Pro Text,14,r,align(l),lh(1.6071),ls(-0.1498px)) p(256,12) s(fill,hug:45) ext(632,) f[(37de84ac640ba77a,tok(color.text.muted,#B8B1AC))] $typography.Body "Why"
          925fc3855a0c6968 r p(0,301.5) s(fill,1) ext(888,) f[(5c220ba16e859bf7,tok(color.edge,#2D2724))] "Line"
          7b37e1ca53b1f3be al(h,g(16:$spacing.lg),pad(12:$spacing.md,0:$spacing.none,12:$spacing.md,0:$spacing.none)) p(0,302.5) s(fill,hug:69) ext(888,) f[] "Principle"
            641912d707ecd170 t("Steps, not one-offs",SF Pro Text,14,m,align(l),lh(1.6071),ls(-0.1498px)) p(0,12) s(240,hug:22.5) f[(402c735a255cfb7a,tok(color.text,#EEE6E1))] $typography.Emphasis "Headline"
            3caa5a846ed7a10c t("The greys are even steps of one ramp, text is made to a contrast as APCA measures it, and a colour over another is at one of seven strengths, so the next one is a choice among a few.",SF Pro Text,14,r,align(l),lh(1.6071),ls(-0.1498px)) p(256,12) s(fill,hug:45) ext(632,) f[(ec2c6e4ee8a573ff,tok(color.text.muted,#B8B1AC))] $typography.Body "Why"
