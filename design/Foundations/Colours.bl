      2d5df9788bda62a7 t("C2 · What colours is code drawn in?",SF Pro Text,16,m,align(l),lh(auto,1.19),ls(-0.3104px)) p(16,16) s(hug:264.47,hug:19) f[(42f56e066a9ef16d,tok(color.text,#EEE6E1))] $typography.Heading "Question"
      49cd5eacbbe83e06 t("Between Dark+ as it ships, outside the roles, and a role for each of Dark+'s colours, with plain code in text.",SF Pro Text,14,r,align(l),lh(1.6071),ls(-0.1498px)) p(16,47) s(fill,hug:22.5) ext(880,) f[(9ee054b812e39f0c,tok(color.text.muted,#B8B1AC))] $typography.Body "Between"
      6c02015fd9e6afa4 t("look::highlight colours code in a diff, a file, a call and, since 2026-11-26, a reply, in Visual Studio's Dark+ as bat ships it. Dark+ has 20 colours, plain code's among them, and no role names any, so no canvas can draw code with roles yet. A code block with no language is drawn in text.",SF Pro Text,14,r,align(l),lh(1.6071),ls(-0.1498px)) p(16,81.5) s(fill,hug:67.5) ext(880,) f[(c572349d432ff568,tok(color.text,#EEE6E1))] $typography.Body "Context"
