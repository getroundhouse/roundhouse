+    #[test]
+    fn a_node_an_inline_plugin_makes_of_a_link_is_still_that_link() {
+        let source = "See **[the fix](https://example.com/12 \"Fix\")** now";
+        let extensions = MarkdownExtensions::default().plugin(
+            crate::text::markdown_ext::TestInlinePlugin::new("test").parse_with(|node, _| {
+                let Node::Link(_) = node else {
+                    return None;
+                };
+                Some(MarkdownNode::new("reference", ()).text(node.to_string()))
+            }),
+        );
+        let mut cx = NodeContext {
+            markdown_extensions: extensions.into(),
+            ..Default::default()
+        };
+        let document = parse(source, &mut cx).unwrap();
+        let BlockNode::Paragraph(paragraph) = &document.blocks[0] else {
+            panic!()
+        };
+        let object = paragraph
+            .children
+            .iter()
+            .find(|node| node.custom.is_some())
+            .expect("the link's node");
+        let link = object.marks.iter().find_map(|(_, mark)| mark.link.as_ref());
+        assert_eq!(
+            link.map(|link| (link.url.as_ref(), link.title.as_deref())),
+            Some(("https://example.com/12", Some("Fix")))
+        );
+        assert!(
+            object.marks.iter().any(|(_, mark)| mark.bold),
+            "and the marks around it"
+        );
+        assert_eq!(object.custom.as_ref().unwrap().as_markdown(), "the fix");
+        assert_eq!(document.text(), "See the fix now\n");
+        assert!(
+            document
+                .to_markdown()
+                .contains("[**the fix**](https://example.com/12 \"Fix\")"),
+            "{}",
+            document.to_markdown()
+        );
+    }
