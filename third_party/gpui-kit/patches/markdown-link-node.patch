+/// Where `link` goes, as its mark has it.
+fn link_mark(link: &mdast::Link) -> LinkMark {
+    LinkMark {
+        url: link.url.clone().into(),
+        title: link.title.clone().map(|s| s.into()),
+        ..Default::default()
+    }
+}
+
+/// The source of `link`'s words, from its first child to its last, or `""`
+/// when it has none.
+fn link_words_source<'a>(link: &mdast::Link, cx: &MarkdownParseContext<'a>) -> &'a str {
+    let start = link.children.first().and_then(|child| child.position());
+    let end = link.children.last().and_then(|child| child.position());
+    start
+        .zip(end)
+        .and_then(|(start, end)| cx.source().get(start.start.offset..end.end.offset))
+        .unwrap_or_default()
+}
