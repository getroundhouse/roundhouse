+    /// A focus ring is painted outside its control, so the body must leave
+    /// room for one on a control at its top or bottom rather than clip it.
+    /// A press is clipped as paint is, so where presses land says what shows.
+    #[gpui::test]
+    fn a_focus_ring_at_the_edge_of_the_body_is_not_clipped(cx: &mut TestAppContext) {
+        let cx = window(cx, size(px(1000.), px(800.)));
+        let presses = Rc::new(Cell::new(0));
+        let counter = presses.clone();
+        open(cx, move |dialog, _, _| {
+            let counter = counter.clone();
+            // The only thing in the body, so it is at both of its edges, with
+            // a probe around it where its focus ring would be.
+            let control = div().relative().h(px(32.)).child(
+                div()
+                    .id("ring-probe")
+                    .debug_selector(|| "ring-probe".into())
+                    .absolute()
+                    .top(-FOCUS_RING_WIDTH)
+                    .left(-FOCUS_RING_WIDTH)
+                    .right(-FOCUS_RING_WIDTH)
+                    .bottom(-FOCUS_RING_WIDTH)
+                    .on_click(move |_, _, _| counter.set(counter.get() + 1)),
+            );
+            dialog.child(control).footer(div().h(px(32.)))
+        });
+
+        let ring = cx.debug_bounds("ring-probe").unwrap();
+        let x = ring.center().x;
+        cx.simulate_click(point(x, ring.top() + px(1.)), gpui::Modifiers::default());
+        assert_eq!(presses.get(), 1, "the body clipped the top of the ring");
+        cx.simulate_click(point(x, ring.bottom() - px(1.)), gpui::Modifiers::default());
+        assert_eq!(presses.get(), 2, "the body clipped the bottom of the ring");
+    }
+
