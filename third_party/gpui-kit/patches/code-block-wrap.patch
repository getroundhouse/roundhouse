+/// `drawn`, the whole of `block` as it's drawn, as `wrap` wraps it, if there's
+/// a wrap.
+fn wrapped(
+    wrap: &Option<Arc<CodeBlockWrapFn>>,
+    block: &CodeBlock,
+    drawn: Stateful<Div>,
+    window: &mut Window,
+    cx: &mut App,
+) -> AnyElement {
+    match wrap {
+        Some(wrap) => wrap(block, drawn, window, cx),
+        None => drawn.into_any_element(),
+    }
