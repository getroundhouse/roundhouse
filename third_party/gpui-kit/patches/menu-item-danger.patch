+    pub fn danger(mut self, danger: bool) -> Self {
+        match &mut self {
+            PopupMenuItem::Item { danger: d, .. } => {
+                *d = danger;
+            }
+            PopupMenuItem::ElementItem { danger: d, .. } => {
